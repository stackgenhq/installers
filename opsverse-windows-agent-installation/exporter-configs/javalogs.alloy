// StackGen ObserveNow - Java service / DataSync log file collection
// Tails log files matching the glob below and ships them to ObserveNow.
//
// After editing, reload the agent:
//   Invoke-WebRequest -Method POST -Uri http://localhost:12345/-/reload -UseBasicParsing

local.file_match "java_services" {
  path_targets = [{
    __path__ = "__LOG_PATH__",
    job      = "java-services",
    host     = "__HOSTNAME__",
  }]

  // Skip rotated logs older than 48h so a directory full of old files does
  // not drive up CPU (see grafana/alloy#6209).
  ignore_older_than = "48h"
}

loki.source.file "java_services" {
  targets    = local.file_match.java_services.targets
  forward_to = [loki.write.observenow.receiver]
}
